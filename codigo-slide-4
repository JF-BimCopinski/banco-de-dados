create table USUARIOS (
  idUsuario INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL
);

create table BANCO (
  idBanco INT PRIMARY KEY AUTO_INCREMENT,
  nome VARCHAR(100) NOT NULL
);

create table CONTABANCARIA (
  idContaBancaria INT PRIMARY KEY AUTO_INCREMENT,
  tipoContaBancaria VARCHAR(100) NOT NULL,
  idUsuario INT NOT NULL,
  idBanco INT NOT NULL,
  FOREIGN KEY (idUsuario) REFERENCES USUARIOS (idUsuario),
  FOREIGN KEY (idBanco) REFERENCES BANCO (idBanco)
);

create table CATEGORIA (
  idCategoria INT PRIMARY KEY AUTO_INCREMENT,
  categoria VARCHAR(100) NOT NULL
);

create table METODOPAGAMENTO (
  idMetodoPagamento INT PRIMARY KEY AUTO_INCREMENT,
  metodoPagamento VARCHAR(100) NOT NULL
);

