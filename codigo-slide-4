-- Liste todas as despesas juntamente com o nome da categoria. Exiba: descrição; valor; categoria.
select D.descricao, D.valor, C.categoria from DESPESAS D join CATEGORIA C on D.idCategoria = C.idCategoria;

-- Liste todas as receitas mostrando: descrição; valor; conta em que foram recebidas.
select R.nome, R.valor, C.tipoContaBancaria
from RECEBIMENTOS R
join CONTABANCARIA C on R.idContaBancaria = C.idContaBancaria;

-- Liste todas as categorias existentes, mesmo aquelas que ainda não possuem despesas cadastradas.
select C.categoria, D.descricao
from CATEGORIA C
left join DESPESAS D
on C.idCategoria = D.idCategoria;

-- Mostre apenas as categorias que nunca foram utilizadas.
select C.categoria from CATEGORIA C left join DESPESAS D on C.idCategoria = D.idCategoria where D.idCategoria is null;

-- Liste todas as contas bancárias de um usuário, mostrando também o banco correspondente.
select U.nome, C.tipoContaBancaria, B.nome
from USUARIOS U
join CONTABANCARIA C on U.idUsuario = C.idUsuario
join BANCO B on C.idBanco = B.idBanco;
